# MongoDB connection string (Atlas or local). Must be a full URI including the database name.
MONGODB_URI=mongodb+srv://cookieyapps150_db_user:edDGGynHbNx6WcxB@cluster0.neuxp6z.mongodb.net/?appName=Cluster0

# NextAuth / Auth.js
# Generate with: npx auth secret
AUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Public base URL used to build tracking links inside simulated phishing emails
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: SMTP settings for actually sending phishing-simulation emails.
# If left unset, campaigns run in "simulated send" mode: emails are logged
# to the console and stored in the database instead of being delivered,
# so the whole product works out of the box without an email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="SecureGuard <no-reply@secureguard.local>"

# Seed script: credentials for the first admin account
SEED_ADMIN_EMAIL=admin@secureguard.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Alex Admin"
