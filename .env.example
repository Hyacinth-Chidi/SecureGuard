# Required
MONGODB_URI=mongodb://127.0.0.1:27017/secureguard
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional mail delivery.
# If SMTP_HOST is not set, campaign sends are simulated by the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=training@secureguard.local
SMTP_FROM_NAME=SecureGuard

# Optional seed/admin defaults
SEED_ADMIN_EMAIL=admin@secureguard.local
SEED_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ORGANIZATION_NAME=SecureGuard Legacy
DEFAULT_ORGANIZATION_SLUG=secureguard-legacy
DEFAULT_ORGANIZATION_DOMAIN=secureguard.local
DEFAULT_ORGANIZATION_INDUSTRY=General

# Disabled by default because tenant employee onboarding should use invites.
ENABLE_SELF_REGISTRATION=false
